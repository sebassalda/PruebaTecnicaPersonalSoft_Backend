# No incluir .env real en Git. Docker Compose lee .env automáticamente;
# Spring Boot necesita que las variables se exporten al proceso.
DB_NAME=brp_management
DB_USER=brp_user
DB_PASSWORD=CAMBIAR_PASSWORD_LOCAL
DB_URL=jdbc:postgresql://localhost:5433/brp_management
APP_JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_BASE64
APP_JWT_EXPIRATION_MINUTES=60
APP_ATTACHMENTS_DIR=./data/attachments
# Habilitar SOLO en el primer arranque sobre una BD nueva SIN administradores:
APP_LIQUIBASE_CONTEXTS=bootstrap-admin
APP_ADMIN_EMAIL=admin@brp.local
APP_ADMIN_PASSWORD_HASH=REEMPLAZAR_CON_HASH_BCRYPT
